# Copia este archivo con el nombre .env y rellena tus datos.
# El archivo .env es personal: nunca se publica (está excluido en .gitignore).

# Carpeta donde se guardan tus investigaciones (una subcarpeta por proyecto).
LORU_DATOS=~/Investigacion

# Tu correo: Crossref pide que quien consulta se identifique.
LORU_CORREO=tu.correo@universidad.es
